.by{text-align:center;color:#555;margin-bottom:20px}
input{
  width:100%;
  padding:12px;
  box-sizing:border-box;
  border:1px solid #aaa;
  border-radius:8px;
  font-size:16px;
}
button{
  padding:12px 20px;
  border:0;
  border-radius:8px;
  background:#173b73;
  color:white;
  font-size:16px;
  cursor:pointer;
}
